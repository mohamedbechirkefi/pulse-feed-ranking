  },
  {
   "name": "Loop",
   "value": "T = 200 steps; candidate pool C = 50, identical across rankers; slate k = 10",
   "source": "manuscript section 3"
  },
  {
   "name": "Examination",
   "value": "position j examined with probability 0.85^(j-1)",
   "source": "manuscript section 3"
  },
  {
   "name": "Choice",
   "value": "like with probability sigmoid((r_ui - c) / tau); feedback flipped with probability eta",
   "source": "manuscript section 3"
  },
  {
   "name": "Calibrated like rate",
   "value": "L* = 0.577143, the share of MovieLens 1M calibration-half ratings of 4 or more (a selected-exposure like rate)",
